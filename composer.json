{
  "name": "geithware/debug-mysql-db",
  "type": "typo3-cms-extension",
  "description": "Debug Mysql or other DB - Extends \\TYPO3\\CMS\\Core\\Database\\Connection and \\TYPO3\\CMS\\Typo3DbLegacy\\Database\\DatabaseConnection to show errors and debug messages. Debugging of SQL queries by debug and FileWriter. Useful for viewing and debugging of SQL queries.",
  "keywords": [
    "TYPO3",
    "debug",
    "mysql",
    "query"
  ],
  "support": {
    "issues": "https://github.com/franzholz/debug_mysql_db/issues"
  },
  "homepage": "https://jambage.com",
  "authors": [
    {
      "name": "Franz Holzinger",
      "role": "Developer",
      "homepage": "https://ttproducts.de"
    }
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13 || ^14 "
  },
  "suggest": {
    "friendsoftypo3/typo3db-legacy": "^1.2",
    "jambagecom/fh-debug": "^0.18"
  },
  "autoload": {
    "psr-4": {
      "Geithware\\DebugMysqlDb\\": "Classes"
    }
  },
  "replace": {
    "typo3-ter/debug-mysql-db": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "debug_mysql_db",
        "version": "1.9.6",
        "Package": {
            "providesPackages": {}
        }
    }
  }
}
